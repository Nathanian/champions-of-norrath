# Ignore everything by default
*

# Explicitly allow the source/ directory structure
!source/
!source/**
!source/.gitignore
!source/.gitattributes
!source/LICENSE
!source/README.md
!source/AGENTS.md
!source/build.py
!source/build.json
!source/objdiff.json
!source/splat.yaml
!source/symbol_addrs.txt
!source/include/**
!source/src/**

# Ignore generated content inside source/
source/asm/
source/assets/
source/build/
source/baserom*
source/*.d
source/*_auto.txt
source/*.ld
source/*.map
source/.splat/
source/*.o
source/*.obj

# Also ignore root-level generated files
baserom*
*.elf
*.rom
*.iso
*.bin
*.bin.cue
*.cue
*.mdf
*.mds
*.chd
*.cso
*.zso
*.zst
*.pbp
*.zip
asm/
assets/
build/
expected/
*.elf
*.rom
*.iso
*.bin
*.chd
*.cso
*.zso
*.pbp
*.zip
*.ld
*.map
*.d
*_auto.txt
*.o
*.obj
*.db
*.db-*
.splat/
*.tmp
ctx.c
ctx.c.m2c

# Editor / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
.vs/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Python environment
__pycache__/
*.py[cod]
.venv/
venv/
compiler/
tools/download/

# Scratch files
ctx.c
ctx.c.m2c
*.tmp