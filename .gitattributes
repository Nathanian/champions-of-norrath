# Normalize line endings across platforms
* text=auto eol=lf

# Windows-only files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files that must never be diffed or modified
*.elf binary
*.rom binary
*.bin binary
*.chd binary
*.cso binary
*.zso binary
*.iso binary
*.cue binary
*.o binary
*.db binary
*.db-wal binary
*.db-shm binary
